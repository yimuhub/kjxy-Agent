# =============================================================================
# 生产环境变量占位模板 —— 复制为 .env.production 并填真实值，绝不提交真实值
#   cp .env.production.example .env.production && chmod 600 .env.production
# 用法：
#   docker compose --env-file .env.production -f docker-compose.prod.yaml up -d --build
# =============================================================================

# ---- 必填：缺失时 compose 直接拒绝启动（compose 层有 :? 校验） ----
# PostgreSQL 密码（≥16 位随机；生成：openssl rand -base64 24）
POSTGRES_PASSWORD=
# Redis 密码（同上）
REDIS_PASSWORD=
# 应用密钥（≥32 位随机；签名所有 JWT；生成：openssl rand -hex 32）
APP_SECRET_KEY=

# ---- 平台管理员 bootstrap：生产禁止 admin/root 等弱名单（config 启动校验会拒） ----
PLATFORM_ADMIN_USERNAMES=change-me-unique-admin

# ---- 建议显式声明（与 compose 内默认一致） ----
# 试运行/公网部署建议关闭自助注册，改邀请制
SIGNUP_ENABLED=false
# 生产供应商 API Key 加密主密钥（Fernet；生成：python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"）
SUPPLIER_KEY_SECRET=

# ---- 可选 ----
# 对外 Web 入口端口（nginx 容器 80 映射到宿主机哪个端口）
HTTP_PORT=80
# 手机配对 pair_url 携带的对外端口（nginx 部署即对外端口；默认 8000 仅适合直连 API）
PAIRING_ADVERTISE_PORT=80
