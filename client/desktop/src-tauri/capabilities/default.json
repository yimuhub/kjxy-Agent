{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "桌面壳默认能力：splash/主窗体加载引擎页面；sidecar 仅允许内置 techyard-sidecar",
  "windows": ["*"],
  "permissions": [
    "core:default",
    "dialog:default",
    "opener:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/techyard-sidecar",
          "sidecar": true
        }
      ]
    }
  ]
}
