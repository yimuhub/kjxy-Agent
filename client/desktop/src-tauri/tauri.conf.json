{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "科技小院",
  "version": "0.1.0",
  "identifier": "cn.techyard.desktop",
  "build": {
    "frontendDist": "../dist-web"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/techyard-sidecar"],
    "resources": ["frontend-dist/**/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
