{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "科技小院",
  "version": "1.6.0",
  "identifier": "cn.techyard.desktop",
  "build": {
    "frontendDist": "../dist-web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/techyard-sidecar"],
    "resources": ["frontend-dist/**/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "webviewInstallMode": {
        "type": "fixedRuntime",
        "version": "10554"
      }
    },
    "macOS": {
      "category": "public.app-category.productivity"
    },
    "linux": {
      "fileformat": ["deb", "appimage"],
      "deb": {
        "depends": []
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI3Mjg5RkU5MjNEOURDNTgKUldSWTNOa2o2WjhvdDByUEV0NFhRQ21NbXAyK2oxVGFra09tNGdsRTVwYmtmamRyM25kM3VrYzAK",
      "endpoints": [
        "https://github.com/yimuhub/kjxy-Agent/releases/latest/download/latest.json"
      ]
    }
  }
}
