{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "科技小院",
  "version": "3.8.0",
  "identifier": "cn.techyard.desktop",
  "build": {
    "frontendDist": "../dist-web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/techyard-sidecar"
    ],
    "resources": [
      "frontend-dist/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRFODhDREYxQ0Y3NjJCMDYKUldRR0szYlA4YzJJVGd1dytLc2xia1JhVGgwV0VoakFMMHlwMUZXd0dZN2l6UkxyNWswYmdGRnQK",
      "endpoints": [
        "https://github.com/yimuhub/kjxy-Agent/releases/latest/download/latest.json"
      ]
    }
  }
}
