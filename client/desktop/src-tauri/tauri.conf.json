{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "科技小院",
  "version": "3.74.0",
  "identifier": "cn.techyard.desktop",
  "build": {
    "frontendDist": "../dist-web"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self' http://127.0.0.1:* http://localhost:* http://192.168.*:* http://10.*:*; img-src 'self' data: blob: http://127.0.0.1:* http://localhost:*; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/techyard-sidecar"
    ],
    "resources": [
      "frontend-dist/**/*",
      "asr-model"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "entitlements": "Entitlements.plist",
      "signingIdentity": "-"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNBMkUzOTc4MUY3QzE3NzQKUldSMEYzd2ZlRGt1T2dXZVM4SnZSS0RPU3BjRldzT093SC9BMm0wa3FuVTlrL05ORldIWFJWeFAK",
      "endpoints": [
        "https://github.com/yimuhub/kjxy-Agent/releases/latest/download/latest.json"
      ]
    }
  }
}
