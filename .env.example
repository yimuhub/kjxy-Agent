# =============================================================================
# 科技小院平台环境变量示例
# 复制为 .env 后按需修改。绝不在此文件或 .env 中填写生产真实密钥并提交 Git。
# =============================================================================

APP_ENV=development
APP_NAME=tech-yard-platform
APP_SECRET_KEY=replace-with-long-random-secret-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- 数据库 / Redis ---
DATABASE_URL=postgresql+psycopg://app_user:change-me@postgres:5432/techyard
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- 文件存储 ---
FILE_STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/data/files
UPLOAD_MAX_MB=50

# --- 模型接入 ---
# fake: 内置 Mock（开发/CI 默认，无需 Key，可跑通全链路）
# openai_compatible: 兼容 OpenAI API 的供应商
LLM_PROVIDER=fake
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=2048

# --- 对话内方案合成（v3.14）---
# 方案成稿的输出 Token 上限：不设上限会被供应商默认值截成一段话
PLAN_MAX_TOKENS=6000
# 方案成稿的单次超时：整份方案远超全局 LLM_TIMEOUT_SECONDS，60 秒会把长方案截成超时
PLAN_TIMEOUT_SECONDS=180
# 知识库命中达到该条数即视为证据充足，跳过联网检索（省搜索配额与时延）
PLAN_KB_MIN_HITS=3
# 缺失章节自动补写的最大轮数
PLAN_REPAIR_PASSES=1

# 平台管理员 bootstrap：名单中的用户名登录后自动获得 platform_admin 角色
# 生产环境请改为难以猜测的专有用户名
PLATFORM_ADMIN_USERNAMES=admin

# --- Embedding ---
# mock: 内置确定性 Mock 向量（开发/CI 默认）
# openai_compatible: 走 LLM_BASE_URL 的 /embeddings
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=
EMBEDDING_DIM=1536

# --- 知识库 ---
CHUNK_SIZE=800
CHUNK_OVERLAP=100
RETRIEVAL_TOP_K=5

# --- 政策模块（P1，首版默认关闭） ---
POLICY_MODULE_ENABLED=false

# --- 运行安全与运营（整改升级新增） ---
# 自助注册开关：公网试运行建议 false（邀请制）
SIGNUP_ENABLED=true
# 自助注册限流：同一 IP 在窗口内最多注册次数 / 窗口秒数（E2E 可放宽）
SIGNUP_RATE_LIMIT_MAX_ATTEMPTS=5
SIGNUP_RATE_LIMIT_WINDOW_SECONDS=3600
# 注册/创建账号密码最小长度（生产代码内强制不低于 10）
PASSWORD_MIN_LENGTH=8
# 运维告警 webhook（POST JSON）；为空时降级为 [ALERT] 日志
ALERT_WEBHOOK_URL=
# 是否暴露 /metrics（Prometheus 文本）
METRICS_ENABLED=true
# true 时模型/供应商端点也禁止内网地址（纯公网 SaaS 用；内网私有化保持 false）
ENFORCE_MODEL_EGRESS_GUARD=false
# 超时回收：queued 超时 / running 卡死后由周期任务置 failed（分钟）
TASK_QUEUED_TIMEOUT_MINUTES=30
TASK_RUNNING_TIMEOUT_MINUTES=120

# 生产 compose 必填项（docker compose 会强制校验）：
# POSTGRES_PASSWORD=*** strong password>
# REDIS_PASSWORD=*** strong password>
# API_IMAGE / WORKER_IMAGE / WEB_IMAGE=固定版本镜像标签（禁止 latest）

LOG_LEVEL=INFO
# 供应商 API Key 加密主密钥（Fernet；生产必须配置，生成: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"）
SUPPLIER_KEY_SECRET=
# 技能签名私钥种子（base64url 编码的 32 字节 Ed25519 种子；留空则由 APP_SECRET_KEY 派生）
# 生成: python -c "import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
SKILL_SIGNING_SEED=

# --- GitHub 市场源（国内网络降级，v3.2） ---
# GitHub API 基址：/search/repositories、/repos/{owner}/{repo} 等路径保持不变；
# 国内可整体替换为路径兼容的反代网关。默认官方，无需配置。
GITHUB_API_BASE=https://api.github.com
# raw.githubusercontent.com 镜像（逗号分隔，官方失败后按序尝试；成功镜像缓存健康 60s，
# 失败镜像 5 分钟冷却期内跳过）。支持两种拼接写法（按镜像实际规则选择）：
#   ① 前缀式：镜像前缀后直接拼完整原始 URL，例如
#      https://ghfast.top/https://raw.githubusercontent.com/owner/repo/main/SKILL.md
#   ② 模板式：含 {url}（完整原始 URL）或 {path}（路径部分，含前导 /）占位符，
#      整站改写型镜像用 {path}，例如
#      https://raw.gitmirror.com{path} -> https://raw.gitmirror.com/owner/repo/main/SKILL.md
# 拼接结果非 http(s) 的条目会被忽略。默认值即可用，无需配置。
GITHUB_RAW_MIRRORS=https://ghfast.top,https://gh-proxy.com,https://raw.gitmirror.com{path}
# 仓库 zip 下载镜像（逗号分隔前缀式：镜像前缀 + 完整原始 zip URL），官方失败后按序尝试。
GITHUB_ZIP_MIRRORS=https://ghfast.top,https://gh-proxy.com
