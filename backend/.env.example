# =============================================================================
# 纯本机运行（不依赖 Docker / Postgres / Redis）
# 用法：复制为 backend/.env 后直接运行；也可逐行 export。
# 说明：SQLite 存数据、Fake 模型免 Key、WORKER_SYNC_FALLBACK 让后台任务降级为本机线程。
# =============================================================================

APP_ENV=development
APP_SECRET_KEY=dev-secret-please-change-min-32-chars-xxxxxxxxxxxx

# SQLite：路径相对于 backend/ 工作目录
DATABASE_URL=sqlite:///./data/dev.db

# 本机文件存储（相对于 backend/）
LOCAL_STORAGE_PATH=./data/files

# 模型：fake/provider 免 Key，开箱即用
LLM_PROVIDER=fake
EMBEDDING_PROVIDER=mock

# 无 Redis 时，后台任务（文档解析/任务执行）降级为本机线程执行
WORKER_SYNC_FALLBACK=true

# 检索（混合检索权重，见 docs/retrieval-tuning.md）
#RETRIEVAL_MODE=hybrid
#RETRIEVAL_ALPHA=0.7

# 平台管理员 bootstrap（逗号分隔）
PLATFORM_ADMIN_USERNAMES=admin

LOG_LEVEL=INFO
